# --- Provider selection -----------------------------------------------------
# LLM_PROVIDER: anthropic | openai | gemini | groq
LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER: openai | gemini | local | hash
#   gemini = free tier, hash = offline with no key, local = sentence-transformers
EMBEDDING_PROVIDER=gemini

# --- API keys ---------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Groq (free tier, fast demos; text only, no screenshot analysis): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Models -----------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store -----------------------------------------------------------
# CHROMA_MODE: persistent | memory (use memory on Streamlit Community Cloud)
CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma

# --- Behaviour --------------------------------------------------------------
MAX_REVISIONS=2
LOG_LEVEL=INFO